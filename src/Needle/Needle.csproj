<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <Optimize>true</Optimize>
    <RootNamespace>Needle</RootNamespace>
    <AssemblyName>Needle</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Simple Attention Network for on-device function calling — .NET 10 port</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency. Everything else — the model, the .cact reader and
         the SentencePiece tokenizer — is plain float[] / Span<float> over
         Vector<float> and TensorPrimitives. -->
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" />
  </ItemGroup>

</Project>
